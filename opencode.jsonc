{
  "$schema": "https://opencode.ai/config.json",

  // Бесплатная модель по умолчанию: не даёт новой сессии незаметно
  // переключиться на платный провайдер. Модель можно сменить через /models.
  "model": "opencode/deepseek-v4.1-flash-free",

  // Основная работа идёт на текущем reasoning effort (max), чтобы не терять
  // качество. Сжатие истории выполняет та же бесплатная модель, даже если
  // сессия явно переключена на платную.
  "agents": {
    "build": {},
    "compaction": {
      "model": "routerai/deepseek/deepseek-v4.1-flash-1017"
    }
  },

  // Раньше запускаем автосжатие (buffer), сохраняя стандартные 15k свежего
  // контекста: это уменьшает средний размер запроса, но не обрезает детали
  // последних шагов.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 40000
  },

  // Ограничиваем попадающий в контекст хвост вывода. Полный вывод по-прежнему
  // сохраняется OpenCode в файл; для тестов сохраняется итоговая часть.
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 32768
  },

  // Разрешения проекта. Правила утверждены владельцем репозитория.
  // Порядок важен: последнее совпадение побеждает, поэтому защита идёт
  // после широких разрешений.

  "permissions": [
    // 1. Локальные коммиты и обычный push — без подтверждения: команда
    //    Poster работает автономно, включая ночные этапы.
    { "action": "shell", "resource": "git commit*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },

    // 2. Разрушительные операции запрещены всегда. Идут после allow.
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force-with-lease*", "effect": "deny" },
    { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },

    // 3. Удаление настоящей базы и резервных копий запрещено без отдельного
    //    решения владельца.
    { "action": "shell", "resource": "rm *.db*", "effect": "deny" },
    { "action": "shell", "resource": "rm *backups*", "effect": "deny" },
    // Прямой доступ к рабочей базе минуя штатный механизм обслуживания
    // (Poster/db_maintenance.py): любое чтение/копирование/запись запрещено.
    { "action": "shell", "resource": "*post_bot.db*", "effect": "deny" },

    // 4. Секреты: не читать, не менять, не выводить. Шаблоны путевые,
    //    чтобы обычный текст (например, сообщение коммита со словом .env)
    //    не блокировался.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*/.env*", "effect": "deny" },
    { "action": "shell", "resource": "* .env", "effect": "deny" },
    { "action": "shell", "resource": "* .env *", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },

    // 5. .env.example — безопасный образец. Должен идти ПОСЛЕ deny-правил
    //    выше, иначе его перехватит "*.env.* → deny".
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*/.env.example*", "effect": "allow" },
    { "action": "shell", "resource": "* .env.example*", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // 6. Штатные безопасные операции без подтверждений: чтение истории,
    //    утверждённые проверки и целевые тесты. Эти команды не пишут код и
    //    не касаются секретов. В профилях агентов (.opencode/agents/*.md)
    //    запреты на чтение секретов и запись в код стоят ПОСЛЕ глобальных
    //    правил, поэтому здесь ничего не ослабляется. Приложение
    //    (Poster/post_bot.db) и каталог backups по-прежнему закрыты
    //    правилами 3–4 и повторными deny в профилях агентов.
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show --stat*", "effect": "allow" },
    { "action": "shell", "resource": "make check*", "effect": "allow" },
    { "action": "shell", "resource": "make accept*", "effect": "allow" },
    { "action": "shell", "resource": "make lint*", "effect": "allow" },
    { "action": "shell", "resource": "make test*", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python -m unittest*", "effect": "allow" },
    { "action": "shell", "resource": "ruff --check*", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/ruff --check*", "effect": "allow" },
    { "action": "shell", "resource": "black --check*", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/black --check*", "effect": "allow" },
    { "action": "shell", "resource": "mypy*", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/mypy*", "effect": "allow" },

    // 7. Штатное обслуживание тестовой БД после релиза (утверждено
    //    владельцем: очистка тестовых данных после каждого релиза до
    //    первого публичного выпуска Poster). Разрешена одна команда
    //    (Poster/db_maintenance.py через make) — не набор shell-команд:
    //    без проверенного бэкапа очистка не выполняется. Agent-профили
    //    дописываются ПОСЛЕ проектных правил, поэтому точные allow
    //    для конкретных ролей (менеджер, tester на /tmp-базе) стоят
    //    в конце каждого профиля и выигрывают у deny выше; остальные
    //    роли не имеют исключений и наследуют этот deny.
    { "action": "shell", "resource": "make db-maintain-report*", "effect": "deny" },
    { "action": "shell", "resource": "make db-maintain-clean*", "effect": "deny" }
  ]
}
