{
  "$schema": "https://opencode.ai/config.json",

  // Бесплатная модель по умолчанию: не даёт новой сессии незаметно
  // переключиться на платный провайдер. Модель можно сменить через /models.
  "model": "opencode/deepseek-v4.1-flash-free",

  // Основная работа идёт на текущем reasoning effort (max), чтобы не терять
  // качество. Сжатие истории выполняет та же бесплатная модель, даже если
  // сессия явно переключена на платную.
  "agents": {
    "build": {},
    "compaction": {
      "model": "routerai/deepseek/deepseek-v4.1-flash-1017"
    }
  },

  // Раньше запускаем автосжатие (buffer), сохраняя стандартные 15k свежего
  // контекста: это уменьшает средний размер запроса, но не обрезает детали
  // последних шагов.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 40000
  },

  // Ограничиваем попадающий в контекст хвост вывода. Полный вывод по-прежнему
  // сохраняется OpenCode в файл; для тестов сохраняется итоговая часть.
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 32768
  },

  // ============================================================================
  // Разрешения проекта (OpenCode 2.x: массив rules, ПОСЛЕДНЕЕ совпадение
  // побеждает; правила агентов из .opencode/agents/*.md дописываются ПОСЛЕ
  // этих, поэтому агентские allow могут сузить/расширить только то, что
  // явно указано в профиле).
  //
  // Политика (утверждена владельцем, 2026-11-06): разрешать по умолчанию все
  // штатные операции разработки — python, ruff, black, mypy, pytest/unittest,
  // make, git (включая push в main), патчи, форматирование. Базовая политика
  // OpenCode уже содержит { action: "*", resource: "*", effect: "allow" },
  // поэтому здесь перечислены ТОЛЬКО исключения — небольшим списком:
  //
  //   1. секреты (.env, ключи) — не читать/не писать/не выводить;
  //   2. рабочая база Poster/post_bot.db и каталог backups — закрыты;
  //      штатное обслуживание — make db-maintain-* (отчёт всем, очистка —
  //      менеджеру, тестировщику — только на DB=/tmp/...);
  //   3. необратимые операции: force push, reset --hard, git clean,
  //     rm -rf вне проекта;
  //   4. живой бот и реальный Telegram;
  //   5. git restore/checkout -- — ask: уничтожают незакоммиченные правки.
  //
  // Не добавляйте сюда широкие deny-шаблоны вида `*python*` или `*ruff*`:
  // именно такая конфигурация вызвала 432 повторных отказа и ~36 минут
  // зацикливания на релизе 2.5.4.
  // ============================================================================

  "permissions": [
    // --- 1. Секреты: не читать, не менять, не выводить ----------------------
    // Шаблоны путевые/с разделителями, чтобы обычные команды
    // (grep -rn os.environ Poster, python -c "...") не блокировались.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*secrets*", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "shell", "resource": "* .env", "effect": "deny" },
    { "action": "shell", "resource": "* .env *", "effect": "deny" },
    { "action": "shell", "resource": "*/.env", "effect": "deny" },
    { "action": "shell", "resource": "*/.env *", "effect": "deny" },
    { "action": "shell", "resource": "*/*secrets*", "effect": "deny" },
    { "action": "shell", "resource": "*/*.key*", "effect": "deny" },
    { "action": "shell", "resource": "*/*.pem*", "effect": "deny" },
    { "action": "shell", "resource": "*/*.p12*", "effect": "deny" },
    { "action": "shell", "resource": "*/*id_rsa*", "effect": "deny" },
    { "action": "shell", "resource": "*/*id_ed25519*", "effect": "deny" },
    // .env.example — безопасный образец: разрешён (после deny выше).
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*/.env.example*", "effect": "allow" },
    { "action": "shell", "resource": "* .env.example*", "effect": "allow" },

    // --- 2. Рабочая база и резервные копии ----------------------------------
    // Прямой доступ к рабочей базе минуя штатный механизм обслуживания
    // (Poster/db_maintenance.py через make db-maintain-*) запрещён.
    // Временные тестовые базы в /tmp НЕ затронуты — с ними работают свободно.
    { "action": "shell", "resource": "*post_bot.db*", "effect": "deny" },
    { "action": "shell", "resource": "*backups/*", "effect": "deny" },
    { "action": "shell", "resource": "rm *backups*", "effect": "deny" },
    // Содержимое SQLite-файлов агентам не нужно (чтение/правка через
    // read/edit); тестовые базы в /tmp — исключение. Профили агентов со
    // своим read */edit * allow повторяют эти deny локально.
    { "action": "read", "resource": "*.db", "effect": "deny" },
    { "action": "read", "resource": "*.db-*", "effect": "deny" },
    { "action": "edit", "resource": "*.db", "effect": "deny" },
    { "action": "edit", "resource": "*.db-*", "effect": "deny" },
    { "action": "read", "resource": "/tmp/*.db", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*.db", "effect": "allow" },
    // Очистка рабочей базы — только утверждённый релизный цикл менеджера
    // (allow в профиле poster-manager стоит после этого deny). Отчёт
    // (integrity + проверенный бэкап, без удаления данных) разрешён всем.
    { "action": "shell", "resource": "make db-maintain-clean*", "effect": "deny" },
    { "action": "shell", "resource": "make db-maintain-report*", "effect": "allow" },

    // --- 3. Необратимые операции --------------------------------------------
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git push --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push origin :*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git clean", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "deny" },
    { "action": "shell", "resource": "git update-ref*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git stash drop*", "effect": "deny" },
    { "action": "shell", "resource": "git stash clear*", "effect": "deny" },
    // Уничтожают незакоммиченные правки — требуют подтверждения последствий.
    { "action": "shell", "resource": "git restore*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout --*", "effect": "ask" },
    // Вне проекта ничего не стираем; .git — уничтожение репозитория.
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf $HOME*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf .git*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "killall*", "effect": "deny" },

    // --- 4. Живой бот и реальный Telegram -----------------------------------
    // Продакшн-бот управляется штатно (Poster/botctl.sh); право start/stop/
    // restart выдано менеджеру allow-правилом в его профиле, остальные роли
    // бота не трогают. Прямые вызовы Telegram API запрещены всем — бот ходит
    // туда сам, тесты работают через FakeBot.
    { "action": "shell", "resource": "make run*", "effect": "deny" },
    { "action": "shell", "resource": "python bot.py*", "effect": "deny" },
    { "action": "shell", "resource": "python3 bot.py*", "effect": "deny" },
    { "action": "shell", "resource": "*botctl.sh start*", "effect": "deny" },
    { "action": "shell", "resource": "*botctl.sh stop*", "effect": "deny" },
    { "action": "shell", "resource": "*botctl.sh restart*", "effect": "deny" },
    { "action": "shell", "resource": "*api.telegram.org*", "effect": "deny" }
  ]
}
